# Unity meta files must always have LF endings so diffs stay clean
*.meta -text

# Unity source assets: treat as text where possible
*.cs text
*.shader text
*.asmdef text
*.inputactions text
*.unity -text
*.prefab -text
*.asset -text
*.mat -text
*.anim -text
*.controller -text
*.wlt -text
*.uss text
*.png binary
*.jpg binary
*.wav binary
*.fbx binary
